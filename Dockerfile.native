FROM ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55 AS compile
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential=12.10ubuntu1 cmake=3.28.3-1build7 \
    ninja-build=1.11.1-2 pkg-config=1.8.1-2build1 \
    unzip=6.0-28ubuntu4.1 zip=3.0-13ubuntu0.2 curl=8.5.0-2ubuntu10.15 \
    git=1:2.43.0-1ubuntu7.3 autoconf=2.71-3 \
    automake=1:1.16.5-1.3ubuntu1 libtool=2.4.7-7build1 \
    g++-13=13.3.0-6ubuntu2~24.04.1 python3=3.12.3-0ubuntu2.1 \
    ca-certificates=20260601~24.04.1 && rm -rf /var/lib/apt/lists/*
COPY tools/compile.sh /recipe/compile.sh
COPY patches/cancellable-transfer.patch /recipe/native-transfer.patch
COPY provenance/build-lock.json /recipe/build-lock.json
RUN bash /recipe/compile.sh /build /out
FROM scratch
COPY --from=compile /out /out
